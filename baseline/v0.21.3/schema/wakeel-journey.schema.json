{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "wakeel-journey.schema.json",
 "title": "WAKEEL Journey Graph",
 "description": "رسم تعليمي مستقل عن رسم المعرفة: ترتيب المحطات قرار تدريس، لا ادعاء باعتماد علمي.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_uri",
  "date",
  "status",
  "separation_rule_ar",
  "station_roles",
  "journeys"
 ],
 "properties": {
  "schema": {
   "const": "wakeel.journey-graph.v0.3"
  },
  "schema_uri": {
   "type": "string"
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "status": {
   "type": "string"
  },
  "separation_rule_ar": {
   "type": "string",
   "minLength": 20
  },
  "station_roles": {
   "type": "object",
   "required": [
    "core",
    "optional",
    "reference"
   ],
   "additionalProperties": {
    "type": "string"
   }
  },
  "journeys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title_ar",
     "title_en",
     "status",
     "nature",
     "goal_ar",
     "starts_with_question_ar",
     "independence_note_ar",
     "exit_evidence_ar",
     "chapters",
     "stations"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^JRN-[A-Z]+-\\d{3}$"
     },
     "title_ar": {
      "type": "string"
     },
     "title_en": {
      "type": "string"
     },
     "status": {
      "enum": [
       "skeleton",
       "outlined",
       "built"
      ]
     },
     "nature": {
      "const": "pedagogical_order"
     },
     "goal_ar": {
      "type": "string"
     },
     "starts_with_question_ar": {
      "type": "string"
     },
     "independence_note_ar": {
      "type": "string"
     },
     "exit_evidence_ar": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "title_ar",
        "station_orders",
        "goal_ar"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^CH-[A-Z0-9]+$"
        },
        "title_ar": {
         "type": "string",
         "minLength": 2
        },
        "title_en": {
         "type": "string"
        },
        "station_orders": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1
         },
         "minItems": 1
        },
        "goal_ar": {
         "type": "string",
         "minLength": 10
        },
        "goal_en": {
         "type": "string"
        },
        "content": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "status"
         ],
         "properties": {
          "ar": {
           "type": "string"
          },
          "en": {
           "type": "string"
          },
          "status": {
           "enum": [
            "not_authored",
            "draft",
            "authored",
            "reviewed"
           ]
          }
         }
        }
       }
      }
     },
     "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "order",
        "topic_id",
        "role",
        "why_here_ar"
       ],
       "properties": {
        "order": {
         "type": "integer",
         "minimum": 1
        },
        "topic_id": {
         "type": "string",
         "pattern": "^[A-Z]{2,3}-\\d{3}$"
        },
        "role": {
         "enum": [
          "core",
          "optional",
          "reference"
         ]
        },
        "why_here_ar": {
         "type": "string",
         "minLength": 10
        },
        "why_here_en": {
         "type": "string"
        },
        "deliverable_ar": {
         "type": [
          "string",
          "null"
         ]
        },
        "deliverable_en": {
         "type": [
          "string",
          "null"
         ]
        },
        "activity": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "sees_ar",
          "tries_ar",
          "discovers_ar"
         ],
         "anyOf": [
          {
           "required": [
            "hypothesis_ar",
            "possible_outcomes_ar",
            "interpretation_ar"
           ]
          },
          {
           "required": [
            "expects_ar"
           ]
          }
         ],
         "properties": {
          "sees_ar": {
           "type": "string",
           "minLength": 5
          },
          "tries_ar": {
           "type": "string",
           "minLength": 5
          },
          "sees_en": {
           "type": "string"
          },
          "interpretation_en": {
           "type": "string"
          },
          "hypothesis_en": {
           "type": "string"
          },
          "tries_en": {
           "type": "string"
          },
          "hypothesis_ar": {
           "type": "string",
           "minLength": 5,
           "description": "توقع المتعلم قبل التجربة، لا نتيجة المؤلف"
          },
          "possible_outcomes_ar": {
           "type": "array",
           "minItems": 2,
           "maxItems": 4,
           "items": {
            "type": "string",
            "minLength": 3
           }
          },
          "possible_outcomes_en": {
           "type": "array",
           "minItems": 2,
           "maxItems": 4,
           "items": {
            "type": "string",
            "minLength": 3
           }
          },
          "interpretation_ar": {
           "type": "string",
           "minLength": 10,
           "description": "ما يعنيه كل احتمال، لا ما نتمنى أن يحدث"
          },
          "discovers_ar": {
           "type": "string",
           "minLength": 5
          },
          "discovers_en": {
           "type": "string"
          },
          "expects_ar": {
           "type": "string",
           "description": "عقد قديم: نتيجة يفترضها المؤلف، مهاجر"
          },
          "legacy_contract": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "methodology_notes_ar": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "topic_id",
        "note_ar"
       ],
       "properties": {
        "topic_id": {
         "type": "string",
         "pattern": "^[A-Z]{2,3}-\\d{3}$"
        },
        "note_ar": {
         "type": "string"
        }
       }
      }
     },
     "optional_branches_ar": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "topic_id",
        "when_ar"
       ],
       "properties": {
        "topic_id": {
         "type": "string",
         "pattern": "^[A-Z]{2,3}-\\d{3}$"
        },
        "when_ar": {
         "type": "string"
        }
       }
      }
     },
     "goal_en": {
      "type": "string"
     },
     "starts_with_question_en": {
      "type": "string"
     },
     "independence_note_en": {
      "type": "string"
     },
     "exit_evidence_en": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "methodology_notes_en": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "topic_id",
        "note_en"
       ],
       "properties": {
        "topic_id": {
         "type": "string",
         "pattern": "^[A-Z]{2,3}-\\d{3}$"
        },
        "note_en": {
         "type": "string"
        }
       }
      }
     },
     "optional_branches_en": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "topic_id",
        "when_en"
       ],
       "properties": {
        "topic_id": {
         "type": "string",
         "pattern": "^[A-Z]{2,3}-\\d{3}$"
        },
        "when_en": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "separation_rule_en": {
   "type": "string"
  },
  "station_roles_en": {
   "type": "object",
   "required": [
    "core",
    "optional",
    "reference"
   ],
   "additionalProperties": {
    "type": "string"
   }
  }
 }
}
