{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "wakeel-entry-contracts.schema.json",
 "title": "WAKEEL Standalone Entry Contracts",
 "description": "عقود الدخول المستقل: تمنع تحويل الموضوع إلى بوابة، وتحدد ما يُشرح داخل الصفحة نفسها.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "date", "status", "purpose_ar", "global_rules_ar", "contracts"],
 "properties": {
  "schema": {"const": "wakeel.entry-contracts.v0.3"},
  "date": {"type": "string", "format": "date"},
  "status": {"type": "string"},
  "purpose_ar": {"type": "string", "minLength": 20},
  "global_rules_ar": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "contracts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic_id", "entry_question_ar", "why_standalone_ar", "inline_explanations",
                 "depth_levels", "forbidden_gates_ar", "proof_of_independence_ar"],
    "properties": {
     "topic_id": {"type": "string", "pattern": "^[A-Z]{2,3}-\\d{3}$"},
     "entry_question_ar": {"type": "string", "minLength": 10},
     "why_standalone_ar": {"type": "string", "minLength": 20},
     "inline_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": ["concept_ar", "promise_ar"],
       "properties": {
        "concept_ar": {"type": "string"},
        "promise_ar": {"type": "string", "minLength": 10}
       }
      }
     },
     "depth_levels": {
      "type": "array",
      "minItems": 3,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": ["level", "needs_ar"],
       "properties": {
        "level": {"enum": ["explore", "experiment", "build", "research"]},
        "needs_ar": {"type": "string"}
       }
      }
     },
     "forbidden_gates_ar": {"type": "array", "items": {"type": "string"}, "minItems": 1},
     "proof_of_independence_ar": {"type": "string", "minLength": 10},
     "linked_journey_id": {"type": ["string", "null"], "pattern": "^JRN-[A-Z]+-\\d{3}$"},
     "linked_station_order": {"type": ["integer", "null"], "minimum": 1}
    }
   }
  }
 }
}
