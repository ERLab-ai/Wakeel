   "response_en": "We'll find another slot and send a new invite."
  },
  {
   "id": "R2",
   "label_ar": "اعتذار عن الحضور",
   "label_en": "apology / cannot attend",
   "response_ar": "شكراً لإبلاغنا، سنرسل لك ملخص الاجتماع.",
   "response_en": "Thanks for letting us know; we'll send you the notes."
  },
  {
   "id": "R3",
   "label_ar": "سؤال عن المكان أو الرابط",
   "label_en": "logistics question",
   "response_ar": "الاجتماع في القاعة 2، والرابط في الدعوة.",
   "response_en": "The meeting is in Room 2; the link is in the invite."
  },
  {
   "id": "R4",
   "label_ar": "تأكيد حضور",
   "label_en": "confirmation",
   "response_ar": "ممتاز، نراك هناك.",
   "response_en": "Great, see you there."
  }
 ],
